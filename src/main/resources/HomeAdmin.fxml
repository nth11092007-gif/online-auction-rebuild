<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f0f4ff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.HomeAdminController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="12.0" style="-fx-background-color: white;                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);                      -fx-padding: 0 32 0 24;">
            <Label style="-fx-font-size: 20; -fx-background-color: #fde8ef;                           -fx-padding: 6 8; -fx-background-radius: 10;" text="🛡️" />
            <VBox spacing="1.0">
                <Label style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" text="Bảng điều khiển quản trị" />
                <Label style="-fx-font-size: 11; -fx-text-fill: #aaa;" text="Quản lý người dùng và hệ thống" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #fff0f0;                            -fx-text-fill: #c0392b;                            -fx-font-size: 13;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-border-color: #f5c6c6;                            -fx-border-radius: 8;                            -fx-border-width: 1;                            -fx-padding: 7 18;                            -fx-cursor: hand;" text="🚪  Đăng xuất" />
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label style="-fx-font-size: 18; -fx-background-color: #e8efff;                                   -fx-padding: 6 8; -fx-background-radius: 10;" text="👥" />
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" text="Quản lý Người dùng" />
                        <Label style="-fx-font-size: 11; -fx-text-fill: #aaa;" text="Danh sách tất cả tài khoản trong hệ thống" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Stats badges -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label fx:id="lblTotalUsers" style="-fx-font-size: 12; -fx-font-weight: bold;                                       -fx-text-fill: #1a73e8;                                       -fx-background-color: #e8efff;                                       -fx-background-radius: 20;                                       -fx-padding: 5 14;" text="0 người dùng" />
                    </HBox>
                </HBox>

                <VBox spacing="0.0" style="-fx-background-color: white;                              -fx-background-radius: 16;                              -fx-effect: dropshadow(three-pass-box, rgba(44,108,223,0.10), 18, 0, 0, 6);" VBox.vgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16 20 14 20;                                  -fx-border-color: transparent transparent #f0f4ff transparent;                                  -fx-border-width: 0 0 1.5 0;" />

                    <TableView fx:id="userTable" style="-fx-background-color: transparent;                                       -fx-border-color: transparent;                                       -fx-table-cell-border-color: #f0f4ff;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="60" text="ID">
                                <style>-fx-alignment: CENTER;</style>
                            </TableColumn>
                            <TableColumn fx:id="colUsername" prefWidth="160" text="Tên đăng nhập" />
                            <TableColumn fx:id="colRealName" prefWidth="200" text="Họ và Tên" />
                            <TableColumn fx:id="colEmail" prefWidth="220" text="Email" />
                            <TableColumn fx:id="colBalance" prefWidth="150" text="Số dư (VND)">
                                <style>-fx-alignment: CENTER-RIGHT;</style>
                            </TableColumn>
                            <TableColumn fx:id="colRole" prefWidth="110" text="Vai trò">
                                <style>-fx-alignment: CENTER;</style>
                            </TableColumn>
                            <TableColumn fx:id="colStatus" prefWidth="120" text="Trạng thái">
                                <style>-fx-alignment: CENTER;</style>
                            </TableColumn>
                            <TableColumn fx:id="colAction" prefWidth="140" text="Hành động">
                                <style>-fx-alignment: CENTER;</style>
                            </TableColumn>
                        </columns>
                        <placeholder>
                            <Label style="-fx-font-size: 13; -fx-text-fill: #bbb;" text="Không có dữ liệu người dùng" />
                        </placeholder>
                    </TableView>

                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>
