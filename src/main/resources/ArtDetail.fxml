<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #f4f7fb; -fx-background-radius: 8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Thuộc tính Tranh nghệ thuật">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <GridPane hgap="20.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
            </columnConstraints>
            <children>
                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-font-weight: bold;" text="Tên tác giả" />
                    <TextField fx:id="txtArtistName" prefHeight="35.0" promptText="Tên tác giả" style="-fx-background-color: transparent; -fx-border-color: #ccc; -fx-border-radius: 5;" />
                </VBox>
            <VBox spacing="8.0" GridPane.columnIndex="1">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Năm sáng tác" />
                  <TextField fx:id="txtReleaseDate" prefHeight="35.0" promptText="Năm sáng tác" style="-fx-background-color: transparent; -fx-border-color: #ccc; -fx-border-radius: 5;" />
               </children>
            </VBox>
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </children>
</VBox>
