<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="720.0" prefWidth="1280.0" spacing="0.0"
      style="-fx-background-color: #f0f4ff;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.ProfileController">

   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="1280.0" spacing="12.0"
            style="-fx-background-color: white;
                   -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);
                   -fx-padding: 0 32 0 20;">
         <children>
            <Button fx:id="HandleBack" mnemonicParsing="false" onAction="#handleGoBack"
                    style="-fx-background-color: #f0f4ff;
                           -fx-text-fill: #2d6cdf;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 7 14;
                           -fx-cursor: hand;"
                    text="← Quay lại" />

            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                   text="Trang Cá Nhân &amp; Ví" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="HandleLogout" mnemonicParsing="false" onAction="#handleLogout"
                    style="-fx-background-color: #fff0f0;
                           -fx-text-fill: #c0392b;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-border-color: #f5c6c6;
                           -fx-border-radius: 8;
                           -fx-border-width: 1;
                           -fx-padding: 7 18;
                           -fx-cursor: hand;"
                    text="🚪  Đăng xuất" />
         </children>
      </HBox>

      <HBox prefHeight="656.0" prefWidth="1280.0" spacing="24.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets top="28.0" right="32.0" bottom="28.0" left="32.0" />
         </padding>
         <children>

            <VBox prefWidth="380.0" spacing="0.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 16;
                         -fx-effect: dropshadow(three-pass-box, rgba(44,108,223,0.10), 18, 0, 0, 6);"
                  VBox.vgrow="ALWAYS">
               <children>

                  <HBox alignment="CENTER_LEFT" spacing="12.0"
                        style="-fx-padding: 24 24 20 24;
                               -fx-border-color: transparent transparent #f0f4ff transparent;
                               -fx-border-width: 0 0 1 0;">
                     <children>
                        <Label style="-fx-font-size: 22; -fx-background-color: #e8efff;
                                      -fx-padding: 8 10; -fx-background-radius: 12;" text="👤" />
                        <VBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                                     text="Thông tin cá nhân" />
                              <Label style="-fx-font-size: 12; -fx-text-fill: #aaa;" text="Thông tin tài khoản của bạn" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="0.0" style="-fx-padding: 8 24 24 24;" VBox.vgrow="ALWAYS">
                     <children>

                        <VBox spacing="4.0" style="-fx-padding: 16 0;">
                           <children>
                              <Label style="-fx-font-size: 11; -fx-text-fill: #888; -fx-font-weight: bold;"
                                     text="HỌ VÀ TÊN" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #555;" text="👤" />
                                    <Label fx:id="lblRealName"
                                           style="-fx-font-size: 14; -fx-text-fill: #1a1a2e; -fx-font-weight: bold;"
                                           text="Nguyễn Văn A" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <Separator style="-fx-background-color: #f0f4ff;" />

                        <VBox spacing="4.0" style="-fx-padding: 16 0;">
                           <children>
                              <Label style="-fx-font-size: 11; -fx-text-fill: #888; -fx-font-weight: bold;"
                                     text="EMAIL" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #555;" text="✉️" />
                                    <Label fx:id="lblEmail"
                                           style="-fx-font-size: 14; -fx-text-fill: #1a1a2e;"
                                           text="abc@gmail.com" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <Separator style="-fx-background-color: #f0f4ff;" />

                        <VBox spacing="4.0" style="-fx-padding: 16 0;">
                           <children>
                              <Label style="-fx-font-size: 11; -fx-text-fill: #888; -fx-font-weight: bold;"
                                     text="SỐ ĐIỆN THOẠI" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #555;" text="📱" />
                                    <Label fx:id="lblPhoneNumber"
                                           style="-fx-font-size: 14; -fx-text-fill: #1a1a2e;"
                                           text="0123456789" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                     </children>
                  </VBox>
               </children>
            </VBox>

            <VBox spacing="0.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 16;
                         -fx-effect: dropshadow(three-pass-box, rgba(44,108,223,0.10), 18, 0, 0, 6);"
                  HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <children>

                  <HBox alignment="CENTER_LEFT" spacing="12.0"
                        style="-fx-padding: 24 24 20 24;
                               -fx-border-color: transparent transparent #f0f4ff transparent;
                               -fx-border-width: 0 0 1 0;">
                     <children>
                        <Label style="-fx-font-size: 22; -fx-background-color: #e8efff;
                                      -fx-padding: 8 10; -fx-background-radius: 12;" text="💼" />
                        <VBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                                     text="Quản lý ví" />
                              <Label style="-fx-font-size: 12; -fx-text-fill: #aaa;" text="Số dư và giao dịch của bạn" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="16.0" style="-fx-padding: 20 24 0 24;">
                     <children>
                        <VBox spacing="8.0"
                              style="-fx-background-color: linear-gradient(to bottom right, #1a73e8, #2d6cdf);
                                     -fx-background-radius: 14; -fx-padding: 20;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Số dư khả dụng"
                                     style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12; -fx-font-weight: bold;" />
                              <Label fx:id="lblBalance" text="50,000,000 đ"
                                     style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" />
                              <Label text="💰 Khả dụng ngay"
                                     style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 11;" />
                           </children>
                        </VBox>

                        <VBox spacing="8.0"
                              style="-fx-background-color: linear-gradient(to bottom right, #ff6d00, #f4511e);
                                     -fx-background-radius: 14; -fx-padding: 20;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Số dư đóng băng"
                                     style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12; -fx-font-weight: bold;" />
                              <Label fx:id="lblFrozenBalance" text="50,000,000 đ"
                                     style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" />
                              <Label text="🔒 Đang xử lý"
                                     style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 11;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="16.0" style="-fx-padding: 20 24 24 24;" VBox.vgrow="ALWAYS">
                     <children>

                        <VBox spacing="10.0"
                              style="-fx-background-color: #f7faf8;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #d4edda;
                                     -fx-border-radius: 14;
                                     -fx-border-width: 1.5;
                                     -fx-padding: 20;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="📈  Nạp tiền"
                                     style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0f7a42;" />
                              <Label text="Nhập số tiền muốn nạp"
                                     style="-fx-font-size: 11; -fx-text-fill: #888;" />
                              <TextField fx:id="txtDepositAmount"
                                         promptText="VD: 1,000,000"
                                         style="-fx-background-radius: 8;
                                                -fx-border-color: #c8e6c9;
                                                -fx-border-radius: 8;
                                                -fx-border-width: 1.5;
                                                -fx-padding: 8 12;
                                                -fx-font-size: 13;" />
                              <Button mnemonicParsing="false" onAction="#HandleDeposit"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #0f9d58;
                                             -fx-text-fill: white;
                                             -fx-font-size: 13;
                                             -fx-font-weight: bold;
                                             -fx-background-radius: 9;
                                             -fx-padding: 10 0;
                                             -fx-cursor: hand;"
                                      text="✓  Xác nhận nạp tiền" />
                           </children>
                        </VBox>

                        <VBox spacing="10.0"
                              style="-fx-background-color: #fff8f7;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #f5c6c6;
                                     -fx-border-radius: 14;
                                     -fx-border-width: 1.5;
                                     -fx-padding: 20;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="📉  Rút tiền"
                                     style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #c0392b;" />
                              <Label text="Nhập số tiền muốn rút"
                                     style="-fx-font-size: 11; -fx-text-fill: #888;" />
                              <TextField fx:id="txtWithdrawAmount"
                                         promptText="VD: 500,000"
                                         style="-fx-background-radius: 8;
                                                -fx-border-color: #f5c6c6;
                                                -fx-border-radius: 8;
                                                -fx-border-width: 1.5;
                                                -fx-padding: 8 12;
                                                -fx-font-size: 13;" />
                              <Button fx:id="HandleWithdrawAmount" mnemonicParsing="false" onAction="#HandleWithdraw"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #d32f2f;
                                             -fx-text-fill: white;
                                             -fx-font-size: 13;
                                             -fx-font-weight: bold;
                                             -fx-background-radius: 9;
                                             -fx-padding: 10 0;
                                             -fx-cursor: hand;"
                                      text="✓  Xác nhận rút tiền" />
                           </children>
                        </VBox>

                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </HBox>
   </children>
</VBox>