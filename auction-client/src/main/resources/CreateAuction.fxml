<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #f0f4ff; -fx-background: #f0f4ff;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.CreateAuctionController">
   <content>
      <VBox spacing="0.0" style="-fx-background-color: #f0f4ff;">

         <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="12.0"
               style="-fx-background-color: white;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);
                      -fx-padding: 0 32 0 20;">
            <children>
               <Button mnemonicParsing="false" onAction="#handleGoBack"
                       style="-fx-background-color: #f0f4ff;
                              -fx-text-fill: #2d6cdf;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;
                              -fx-background-radius: 8;
                              -fx-padding: 7 14;
                              -fx-cursor: hand;"
                       text="← Quay lại" />
               <Label text="🔨" style="-fx-font-size: 20; -fx-background-color: #e8efff;
                                       -fx-padding: 6 8; -fx-background-radius: 10;" />
               <VBox spacing="1.0">
                  <children>
                     <Label text="Tạo phiên đấu giá"
                            style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                     <Label text="Điền thông tin để khởi tạo phiên mới"
                            style="-fx-font-size: 11; -fx-text-fill: #aaa;" />
                  </children>
               </VBox>
            </children>
         </HBox>

         <VBox alignment="TOP_CENTER">
            <padding>
               <Insets top="32.0" right="320.0" bottom="40.0" left="320.0" />
            </padding>
            <children>
               <VBox spacing="0.0"
                     style="-fx-background-color: white;
                            -fx-background-radius: 16;
                            -fx-effect: dropshadow(three-pass-box, rgba(44,108,223,0.10), 18, 0, 0, 6);">
                  <padding>
                     <Insets top="32.0" right="40.0" bottom="36.0" left="40.0" />
                  </padding>
                  <children>

                     <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 20 0;">
                        <children>
                           <Label text="📦"
                                  style="-fx-font-size: 18; -fx-background-color: #e8efff;
                                         -fx-padding: 6 8; -fx-background-radius: 10;" />
                           <VBox spacing="2.0">
                              <children>
                                 <Label text="Thông tin cơ bản"
                                        style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                                 <Label text="Mô tả sản phẩm đấu giá của bạn"
                                        style="-fx-font-size: 11; -fx-text-fill: #aaa;" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>

                     <Separator style="-fx-background-color: #f0f4ff;" />

                     <VBox spacing="18.0" style="-fx-padding: 22 0 0 0;">
                        <children>

                           <VBox spacing="6.0">
                              <children>
                                 <Label text="LOẠI SẢN PHẨM"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <ComboBox fx:id="cbItemType" maxWidth="Infinity"
                                           prefHeight="42.0" promptText="Chọn loại sản phẩm"
                                           style="-fx-background-color: #f8faff;
                                                  -fx-border-color: #dce4ff;
                                                  -fx-border-radius: 9;
                                                  -fx-background-radius: 9;
                                                  -fx-border-width: 1.5;
                                                  -fx-font-size: 13;" />
                              </children>
                           </VBox>

                           <VBox spacing="6.0">
                              <children>
                                 <Label text="TÊN SẢN PHẨM"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <TextField fx:id="txtItemName" prefHeight="42.0"
                                            promptText="Nhập tên sản phẩm"
                                            style="-fx-background-color: #f8faff;
                                                   -fx-border-color: #dce4ff;
                                                   -fx-border-radius: 9;
                                                   -fx-background-radius: 9;
                                                   -fx-border-width: 1.5;
                                                   -fx-padding: 0 14;
                                                   -fx-font-size: 13;" />
                              </children>
                           </VBox>

                           <VBox spacing="6.0">
                              <children>
                                 <Label text="MÔ TẢ SẢN PHẨM"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <TextArea fx:id="txtDescription" prefHeight="110.0"
                                           promptText="Nhập mô tả chi tiết về sản phẩm..."
                                           style="-fx-background-color: #f8faff;
                                                  -fx-border-color: #dce4ff;
                                                  -fx-border-radius: 9;
                                                  -fx-background-radius: 9;
                                                  -fx-border-width: 1.5;
                                                  -fx-font-size: 13;" />
                              </children>
                           </VBox>

                           <VBox spacing="8.0">
                              <children>
                                 <Label text="HÌNH ẢNH SẢN PHẨM"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                       <Button onAction="#handleSelectImage"
                                               style="-fx-background-color: #f0f4ff;
                                                      -fx-text-fill: #2d6cdf;
                                                      -fx-font-size: 13;
                                                      -fx-font-weight: bold;
                                                      -fx-border-color: #d0deff;
                                                      -fx-border-radius: 8;
                                                      -fx-border-width: 1.5;
                                                      -fx-background-radius: 8;
                                                      -fx-padding: 8 16;
                                                      -fx-cursor: hand;"
                                               text="🖼  Chọn ảnh" />
                                       <Label fx:id="lblImagePath"
                                              text="Chưa có ảnh nào được chọn"
                                              style="-fx-text-fill: #aaa; -fx-font-size: 12;" />
                                    </children>
                                 </HBox>
                                 <VBox alignment="CENTER" prefHeight="170.0"
                                       style="-fx-background-color: #f8faff;
                                              -fx-border-color: #dce4ff;
                                              -fx-border-width: 1.5;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;">
                                    <children>
                                       <ImageView fx:id="imgPreview" fitHeight="150.0" fitWidth="220.0"
                                                  pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                 </VBox>
                              </children>
                           </VBox>

                           <VBox fx:id="Container" prefWidth="100.0" spacing="10.0" />

                        </children>
                     </VBox>

                     <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 28 0 20 0;">
                        <children>
                           <Label text="⚙️"
                                  style="-fx-font-size: 18; -fx-background-color: #e8efff;
                                         -fx-padding: 6 8; -fx-background-radius: 10;" />
                           <VBox spacing="2.0">
                              <children>
                                 <Label text="Cấu hình phiên đấu giá"
                                        style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                                 <Label text="Thiết lập giá và thời gian đấu giá"
                                        style="-fx-font-size: 11; -fx-text-fill: #aaa;" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>

                     <Separator style="-fx-background-color: #f0f4ff;" />

                     <HBox spacing="16.0" style="-fx-padding: 22 0 0 0;">
                        <children>
                           <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label text="GIÁ KHỞI ĐIỂM (VNĐ)"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <TextField fx:id="txtStartingPrice" prefHeight="42.0"
                                            promptText="VD: 1,000,000"
                                            style="-fx-background-color: #f8faff;
                                                   -fx-border-color: #dce4ff;
                                                   -fx-border-radius: 9;
                                                   -fx-background-radius: 9;
                                                   -fx-border-width: 1.5;
                                                   -fx-padding: 0 14;
                                                   -fx-font-size: 13;" />
                              </children>
                           </VBox>
                           <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label text="BƯỚC GIÁ (VNĐ)"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <TextField fx:id="txtIncrementStep" prefHeight="42.0"
                                            promptText="VD: 100,000"
                                            style="-fx-background-color: #f8faff;
                                                   -fx-border-color: #dce4ff;
                                                   -fx-border-radius: 9;
                                                   -fx-background-radius: 9;
                                                   -fx-border-width: 1.5;
                                                   -fx-padding: 0 14;
                                                   -fx-font-size: 13;" />
                              </children>
                           </VBox>
                           <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label text="SỐ NGÀY MỞ"
                                        style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #888;" />
                                 <TextField fx:id="txtOpenDays" prefHeight="42.0"
                                            promptText="VD: 7"
                                            style="-fx-background-color: #f8faff;
                                                   -fx-border-color: #dce4ff;
                                                   -fx-border-radius: 9;
                                                   -fx-background-radius: 9;
                                                   -fx-border-width: 1.5;
                                                   -fx-padding: 0 14;
                                                   -fx-font-size: 13;" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>

                     <HBox spacing="12.0" style="-fx-padding: 28 0 0 0;">
                        <children>
                           <Button fx:id="btnCreateAution" mnemonicParsing="false"
                                   onAction="#handleCreateAuction"
                                   maxWidth="Infinity" prefHeight="46.0"
                                   style="-fx-background-color: #1a73e8;
                                          -fx-text-fill: white;
                                          -fx-font-size: 14;
                                          -fx-font-weight: bold;
                                          -fx-background-radius: 10;
                                          -fx-cursor: hand;"
                                   text="🔨  Tạo phiên đấu giá"
                                   HBox.hgrow="ALWAYS" />
                           <Button fx:id="btnClearForm" mnemonicParsing="false"
                                   onAction="#handleClearForm"
                                   prefHeight="46.0" prefWidth="140.0"
                                   style="-fx-background-color: #fff0f0;
                                          -fx-text-fill: #c0392b;
                                          -fx-font-size: 14;
                                          -fx-font-weight: bold;
                                          -fx-border-color: #f5c6c6;
                                          -fx-border-radius: 10;
                                          -fx-border-width: 1.5;
                                          -fx-background-radius: 10;
                                          -fx-cursor: hand;"
                                   text="🗑  Xoá form" />
                        </children>
                     </HBox>

                  </children>
               </VBox>
            </children>
         </VBox>

      </VBox>
   </content>
</ScrollPane>
